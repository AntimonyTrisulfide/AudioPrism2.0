#!/bin/bash
#PBS -N audioprism2
#PBS -q dgx
#PBS -l select=1:ncpus=12:mem=64gb:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

PYTHON_BIN="${PYTHON_BIN:-$HOME/.conda/envs/ml/bin/python}"
CONFIG="${CONFIG:-configs/base.yaml}"
RUN_NAME="${RUN_NAME:-bsct_16k_base}"
OUTPUT_DIR="${OUTPUT_DIR:-$PWD/runs}"
NGPUS="${NGPUS:-1}"
RESUME="${RESUME:-${OUTPUT_DIR}/${RUN_NAME}/checkpoints/latest.pt}"
PREPROCESS_IN_JOB="${PREPROCESS_IN_JOB:-1}"
PREPROCESS_PROJECT="${PREPROCESS_PROJECT:-$HOME/AudioPrism_HPC}"
RAW_DIR="${RAW_DIR:-${PREPROCESS_PROJECT}/data/extracted/V2}"
SPLIT_DIR="${SPLIT_DIR:-${PREPROCESS_PROJECT}/splits}"
JOB_TMPDIR="${TMPDIR:-/tmp/${USER}_${PBS_JOBID}}"

if [[ "${PREPROCESS_IN_JOB}" == "1" ]]; then
  PREP_ROOT="${JOB_TMPDIR}/audioprism2_preprocessed"
  TRAIN_DIR="${PREP_ROOT}/train"
  VAL_DIR="${PREP_ROOT}/val"
else
  TRAIN_DIR="${TRAIN_DIR:?Set TRAIN_DIR when PREPROCESS_IN_JOB=0}"
  VAL_DIR="${VAL_DIR:?Set VAL_DIR when PREPROCESS_IN_JOB=0}"
fi

mkdir -p "${OUTPUT_DIR}/${RUN_NAME}/logs"
LIVE_LOG="${OUTPUT_DIR}/${RUN_NAME}/logs/pbs_${PBS_JOBID}.log"

echo "Host: $(hostname)" | tee -a "${LIVE_LOG}"
echo "Started: $(date)" | tee -a "${LIVE_LOG}"
echo "Python: ${PYTHON_BIN}" | tee -a "${LIVE_LOG}"
echo "PBS scratch: ${JOB_TMPDIR}" | tee -a "${LIVE_LOG}"
echo "Train data: ${TRAIN_DIR}" | tee -a "${LIVE_LOG}"
echo "Validation data: ${VAL_DIR}" | tee -a "${LIVE_LOG}"
nvidia-smi | tee -a "${LIVE_LOG}"

if [[ ! -x "${PYTHON_BIN}" ]]; then
  echo "Python executable does not exist: ${PYTHON_BIN}" | tee -a "${LIVE_LOG}"
  exit 2
fi

preprocess_split() {
  local split_name="$1"
  local output_path="$2"
  local split_file="${SPLIT_DIR}/${split_name}.txt"
  echo "Preprocessing ${split_name} into PBS scratch..." | tee -a "${LIVE_LOG}"
  "${PYTHON_BIN}" "${PREPROCESS_PROJECT}/scripts/preprocess_dataset.py" \
    --raw-dir "${RAW_DIR}" \
    --output-dir "${output_path}" \
    --split-file "${split_file}" \
    --chunk-duration 8 \
    --sample-rate 16000 \
    --n-fft 2048 \
    --hop-length 512 2>&1 | tee -a "${LIVE_LOG}"
}

if [[ "${PREPROCESS_IN_JOB}" == "1" ]]; then
  mkdir -p "${JOB_TMPDIR}"
  preprocess_split train "${TRAIN_DIR}"
  preprocess_split val "${VAL_DIR}"
fi

for metadata in "${TRAIN_DIR}/dataset_metadata.pt" "${VAL_DIR}/dataset_metadata.pt"; do
  if [[ ! -f "${metadata}" ]]; then
    echo "Required dataset metadata was not created: ${metadata}" | tee -a "${LIVE_LOG}"
    exit 3
  fi
done

"${PYTHON_BIN}" inspect_dataset.py "${TRAIN_DIR}" --scan-chunks 2 2>&1 | tee -a "${LIVE_LOG}"
"${PYTHON_BIN}" inspect_dataset.py "${VAL_DIR}" --scan-chunks 2 2>&1 | tee -a "${LIVE_LOG}"

cmd=(
  "${PYTHON_BIN}" -m torch.distributed.run
  --standalone
  --nproc_per_node="${NGPUS}"
  train.py
  --config "${CONFIG}"
  --set "name=${RUN_NAME}"
  --set "output_dir=${OUTPUT_DIR}"
  --set "data.train_dir=${TRAIN_DIR}"
  --set "data.val_dir=${VAL_DIR}"
)

if [[ -f "${RESUME}" ]]; then
  cmd+=(--resume "${RESUME}")
  echo "Resuming: ${RESUME}" | tee -a "${LIVE_LOG}"
fi

printf 'Command:' | tee -a "${LIVE_LOG}"
printf ' %q' "${cmd[@]}" | tee -a "${LIVE_LOG}"
printf '\n' | tee -a "${LIVE_LOG}"
"${cmd[@]}" 2>&1 | tee -a "${LIVE_LOG}"
echo "Finished: $(date)" | tee -a "${LIVE_LOG}"
